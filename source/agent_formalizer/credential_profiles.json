{
  "schema_version": 1,
  "defaults": {
    "models": {
      "google-vertex/gemini-3.1-flash-lite": "google-vertex-default"
    },
    "providers": {
      "openai": "openai-default",
      "anthropic": "anthropic-default",
      "openrouter": "openrouter-default",
      "google": "google-default",
      "gemini": "gemini-default",
      "google-vertex": "google-vertex-default",
      "deepseek": "deepseek-default",
      "dashscope": "dashscope-default",
      "qwen": "qwen-default"
    }
  },
  "profiles": {
    "openai-default": {
      "provider": "openai",
      "api_key_env": "OPENAI_API_KEY"
    },
    "anthropic-default": {
      "provider": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "openrouter-default": {
      "provider": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY"
    },
    "google-default": {
      "provider": "google",
      "api_key_env": "GEMINI_API_KEY"
    },
    "gemini-default": {
      "provider": "gemini",
      "api_key_env": "GEMINI_API_KEY"
    },
    "google-vertex-default": {
      "provider": "google-vertex",
      "models": ["google-vertex/*"],
      "api_key_env": "GOOGLE_CLOUD_API_KEY",
      "provider_options": {
        "google_vertex": {
          "project": {"env": "GOOGLE_CLOUD_PROJECT"}
        }
      }
    },
    "google-vertex-fallback": {
      "provider": "google-vertex",
      "models": ["google-vertex/*"],
      "api_key_env": "FALLBACK_GOOGLE_CLOUD_API_KEY",
      "provider_options": {
        "google_vertex": {
          "project": {"env": "FALLBACK_GOOGLE_CLOUD_PROJECT"}
        }
      }
    },
    "deepseek-default": {
      "provider": "deepseek",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "dashscope-default": {
      "provider": "dashscope",
      "api_key_env": "DASHSCOPE_API_KEY"
    },
    "qwen-default": {
      "provider": "qwen",
      "api_key_env": "DASHSCOPE_API_KEY"
    }
  }
}
