{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-formalizer.local/schemas/operational-config-v1.json",
  "title": "Agent Formalizer Operational Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "credential",
    "scheduling",
    "evidence_collection",
    "infra_diagnostics",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "config_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "credential": {"$ref": "#/$defs/credential"},
    "scheduling": {"$ref": "#/$defs/scheduling"},
    "network_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety_margin", "docker_timeout_seconds", "poll_seconds", "orphan_grace_seconds"],
      "properties": {
        "safety_margin": {"type": "integer", "minimum": 0},
        "docker_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "poll_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "orphan_grace_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_collection": {"$ref": "#/$defs/evidence_collection"},
    "infra_diagnostics": {"$ref": "#/$defs/infra_diagnostics"},
    "results": {"$ref": "#/$defs/results"}
  },
  "$defs": {
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_file", "secrets_env_file"],
      "properties": {
        "registry_file": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "secrets_env_file": {"type": "string", "minLength": 1}
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formalizer_workers",
        "solver_workers",
        "val_workers",
        "resume"
      ],
      "properties": {
        "formalizer_workers": {"type": "integer", "minimum": 1},
        "solver_workers": {"type": "integer", "minimum": 1},
        "val_workers": {"type": "integer", "minimum": 1},
        "resume": {"type": "boolean"}
      }
    },
    "evidence_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_trace"],
      "properties": {
        "agent_trace": {"type": "boolean"}
      }
    },
    "infra_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "capture", "provider_diagnostics", "storage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport_errors", "gateway_internal_errors"],
          "properties": {
            "transport_errors": {"type": "boolean"},
            "gateway_internal_errors": {"type": "boolean"}
          }
        },
        "provider_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "capture_success_metadata"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["off", "metadata", "structured", "raw"]
            },
            "capture_success_metadata": {"type": "boolean"},
            "handlers": {
              "type": "object",
              "default": {},
              "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
              "additionalProperties": {
                "type": "string",
                "pattern": "^builtin:[a-z][a-z0-9_-]*@[1-9][0-9]*$"
              }
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "retention_days",
            "max_event_bytes",
            "max_run_bytes"
          ],
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "retention_days": {"type": "integer", "minimum": 1},
            "max_event_bytes": {"type": "integer", "minimum": 1024},
            "max_run_bytes": {"type": "integer", "minimum": 1024}
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {"type": "string", "minLength": 1}
      }
    }
  }
}
